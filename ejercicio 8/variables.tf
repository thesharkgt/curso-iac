variable "nombre_aplicacion" {
  description = "Nombre ficticio de la ficha principal"
  type        = string
  default     = "portal-demo"
}

variable "entorno" {
  description = "Entorno del caso ficticio"
  type        = string
  default     = "pruebas"
}

variable "responsable" {
  description = "Equipo ficticio responsable de las fichas"
  type        = string
  default     = "equipo-lab"
}
